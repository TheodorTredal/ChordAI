# Copy this file to .env and fill in any values you want to override.
# All values shown are the defaults used when the variable is not set.

# ── Ports (host side) ─────────────────────────────────────────────────────────
SERVER_PORT=5555      # Go backend
CLIENT_PORT=3000      # Nuxt frontend

# ── SVCO (voice pipeline, runs outside Docker) ────────────────────────────────
# Point SVCO at the running Go server and Nuxt frontend.
# If running everything locally (not Docker) these defaults are correct.
CHORDAI_SERVER=http://localhost:5555
CHORDAI_FRONTEND=http://localhost:3000

# Combined Go + Python image for the ChordAI backend.
# The Go server calls Python model scripts as subprocesses, so both runtimes
# must live in the same container and share the same filesystem.
#
# Build context: project root (so both server/ and models/ are accessible)

# ── Stage 1: build the Go binary ─────────────────────────────────────────────
FROM golang:1.25-alpine AS go-builder

WORKDIR /build
COPY server/go.mod server/go.sum ./
RUN go mod download

COPY server/ .
RUN CGO_ENABLED=0 GOOS=linux go build -o chordai-server .

# ── Stage 2: final image with Go binary + Python + model deps ────────────────
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3-pip \
    python3.11-venv \
    libsndfile1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

WORKDIR /app

# Install Python deps (cached layer)
COPY models/requirements.txt ./models/requirements.txt
COPY chord-gen/requirements.txt ./chord-gen/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        torch --index-url https://download.pytorch.org/whl/cu121 \
    && pip install --no-cache-dir -r models/requirements.txt \
    && pip install --no-cache-dir -r chord-gen/requirements.txt

# Copy project files
COPY models/ ./models/
COPY chord-gen/ ./chord-gen/
RUN mkdir -p /app/out-chords

# Copy compiled Go binary
COPY --from=go-builder /build/chordai-server .

EXPOSE 5555

CMD ["./chordai-server"]
